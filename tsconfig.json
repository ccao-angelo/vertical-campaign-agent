{
    "compilerOptions": {
        "target": "es2022",
        "lib": ["es2022", "DOM", "DOM.Iterable"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "types": ["node", "vite/client"]
    },
    "include": ["client/src", "server", "shared", "scripts", "*.ts"]
}